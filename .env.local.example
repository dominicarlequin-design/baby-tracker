# Supabase project URL and anon (publishable) key — safe to expose to the
# browser, used by lib/supabase.js for reads/inserts/deletes on baby_events
# and reads on baby_config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ and never
# import lib/supabaseAdmin.js from a Client Component. Used by
# app/api/check-overdue to bypass RLS (reading every push_subscriptions row,
# deleting stale ones, and reading/writing notification_state).
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (app/api/check-overdue + lib/push.js). Generate a
# keypair with `npx web-push generate-vapid-keys`, then:
#   - put the PUBLIC key in Supabase: baby_config.vapid_public_key
#   - put the PRIVATE key here, server-only, never exposed to the browser
# VAPID_SUBJECT must be "mailto:you@example.com" or an https:// URL — it's
# how push services can contact you if your server misbehaves.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret the GitHub Actions workflow (.github/workflows/check-overdue.yml)
# sends as a Bearer token so only that scheduled job (not the public
# internet) can trigger a push-notification check. Any long random string;
# must match the CRON_SECRET repo secret in GitHub Actions.
CRON_SECRET=
