# Supabase project URL and anon (publishable) key — safe to expose to the
# browser, used by lib/supabase.js for reads/inserts/deletes on baby_events
# and reads on baby_config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_ and never
# import lib/supabaseAdmin.js from a Client Component. Used by API routes
# (event time edits) to bypass RLS where the anon role has no policy
# (updates on baby_events).
SUPABASE_SERVICE_ROLE_KEY=
